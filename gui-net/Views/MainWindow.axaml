<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:gui_net.ViewModels"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:automation="using:Avalonia.Automation"
                 x:Class="gui_net.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
                 Width="320" Height="260" MinWidth="320" MinHeight="260"
                 BackgroundStyle="Flat" BackgroundAnimationEnabled="False"
                 Icon="avares://gui-net/Assets/avalonia-logo.ico" Title="Proxy">
    <suki:GlassCard Name="ControlCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280" Padding="20" Margin="20">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="20" ColumnSpacing="20">
            <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Name="ProxyTitle" Text="Proxy" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Spacing="0" ToolTip.Tip="{Binding StatusDetail}">
                    <Button Name="LogsButton" Classes="Basic status-log" Click="OpenLogs_Click"
                            automation:AutomationProperties.Name="Show proxy logs">
                        <ToolTip.Tip>
                            <StackPanel Spacing="4" MaxWidth="360">
                                <TextBlock Text="Show proxy logs" />
                                <TextBlock Text="{Binding StatusDetail}" IsVisible="{Binding HasStatusDetail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToolTip.Tip>
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" />
                    </Button>
                    <TextBlock Name="StatusLabel" Text="{Binding StatusMessage}" FontSize="12" Classes="secondary" Classes.error="{Binding HasError}"
                               VerticalAlignment="Center" IsVisible="{Binding !IsApplyingStatus}" />
                    <ProgressBar Name="ApplyingProgress" Width="24" MinWidth="24" Height="4" VerticalAlignment="Center"
                                 IsIndeterminate="True" IsVisible="{Binding IsApplyingStatus}" ToolTip.Tip="Applying changes" />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="Enable" Foreground="{DynamicResource SukiText}" FontSize="13" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Row="1" Grid.Column="1" Name="ProxyToggle" HorizontalAlignment="Right"
                          IsChecked="{Binding ProxyEnabled, Mode=TwoWay}" IsEnabled="{Binding ControlsEnabled}"
                          automation:AutomationProperties.Name="Enable system proxy">
                <ToggleSwitch.OnContent>
                    <TextBlock Text="On" Foreground="{DynamicResource SukiText}" />
                </ToggleSwitch.OnContent>
                <ToggleSwitch.OffContent>
                    <TextBlock Text="Off" Foreground="{DynamicResource SukiText}" />
                </ToggleSwitch.OffContent>
            </ToggleSwitch>
            <TextBlock Grid.Row="2" Text="Mode" Foreground="{DynamicResource SukiText}" FontSize="13" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Row="2" Grid.Column="1" Name="ModeSwitch" Classes="mode-switch"
                          HorizontalAlignment="Right" IsChecked="{Binding GlobalModeSelected, Mode=TwoWay}"
                          IsEnabled="{Binding ControlsEnabled}" OnContent="Global" OffContent="PAC"
                          automation:AutomationProperties.Name="Proxy routing mode" />
        </Grid>
    </suki:GlassCard>
</suki:SukiWindow>
